<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/launcher_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/bg_gradient"
        android:supportsRtl="true"
        android:theme="@style/Theme.WordMaster">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GameActivity" />
        <activity android:name=".HowToPlayActivity" />
        <activity android:name=".WordsCreationActivity" />
        <activity android:name=".TurnActivity" />
        <activity android:name=".GameplayActivity" />
        <activity android:name=".WinnerActivity" />
    </application>

</manifest>