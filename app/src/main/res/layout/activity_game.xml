<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E1F5FE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game Settings"
            android:textColor="#0277BD"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Όνομα Ομάδας 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/greekTeamName1str"
            android:textColor="#01579B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etTeam1"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/game_input_bg"
            android:hint="@string/greekHintForTeamNameStr"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#212121"
            android:textColorHint="#9E9E9E" />

        <!-- Όνομα Ομάδας 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/greekTeamName2str"
            android:textColor="#01579B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etTeam2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/game_input_bg"
            android:hint="@string/greekHintForTeamNameStr"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#212121"
            android:textColorHint="#9E9E9E" />

        <!-- Συνολικός αριθμός παικτών -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/greekTotalNumPlayersStr"
            android:textColor="#01579B"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/game_input_bg"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvPlayers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="6"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="16dp" />

            <Button
                android:id="@+id/btnPlayersDown"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="#EEEEEE"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="#000000"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnPlayersUp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="#EEEEEE"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="#000000"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Λέξεις ανά παίκτη -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/greekWordsPerPersonStr"
            android:textColor="#01579B"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/game_input_bg"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/tvWords"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="16dp" />

            <Button
                android:id="@+id/btnWordsDown"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="#EEEEEE"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="#000000"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnWordsUp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="#EEEEEE"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="#000000"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Κουμπί -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#4A90D9"
            android:text="@string/writeWordsStr"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>