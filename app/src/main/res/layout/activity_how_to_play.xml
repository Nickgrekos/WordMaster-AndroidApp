<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050816">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to Play"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="28sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"/>

        <!-- CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F4F0FA"
            android:padding="24dp"
            android:elevation="6dp">

            <!-- ROUND 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Γύρος 1 – Περιγραφή"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Περιγράψτε τη λέξη χωρίς να πείτε τις απαγορευμένες λέξεις. Μιλήστε ελεύθερα."
                android:textSize="15sp"
                android:textColor="#444444"
                android:layout_marginBottom="24dp"/>

            <!-- ROUND 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Γύρος 2 – Παντομίμα"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Χωρίς λόγια! Δείξτε τη λέξη με κινήσεις και εκφράσεις."
                android:textSize="15sp"
                android:textColor="#444444"
                android:layout_marginBottom="24dp"/>

            <!-- ROUND 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Γύρος 3 – Μία Λέξη"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Έχετε μόνο μία λέξη για να βοηθήσετε την ομάδα σας."
                android:textSize="15sp"
                android:textColor="#444444"
                android:layout_marginBottom="32dp"/>

            <!-- BUTTON -->
            <Button
                android:id="@+id/btnBackHome"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Back to Home"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#9B6BDB"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>